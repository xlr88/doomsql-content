{
  "id": "sql_008",
  "contentVersion": 1,
  "title": "Customers Who Never Order",
  "difficulty": "MEDIUM",
  "sqlDialect": "SQLITE",
  "tags": ["left join", "null", "join"],
  "description": "Find the names of all customers who have never placed any orders. Return a single column named name.",
  "orderSensitive": false,
  "tables": [
    {
      "name": "Customer",
      "columns": [
        { "name": "id", "type": "INTEGER", "nullable": false, "primaryKey": true },
        { "name": "name", "type": "TEXT", "nullable": false, "primaryKey": false }
      ],
      "rows": [
        [1, "Joe"],
        [2, "Henry"],
        [3, "Sam"],
        [4, "Max"]
      ]
    },
    {
      "name": "Orders",
      "columns": [
        { "name": "id", "type": "INTEGER", "nullable": false, "primaryKey": true },
        { "name": "customer_id", "type": "INTEGER", "nullable": false, "primaryKey": false },
        { "name": "amount", "type": "REAL", "nullable": false, "primaryKey": false }
      ],
      "rows": [
        [1, 3, 250],
        [2, 1, 300],
        [3, 1, 150]
      ]
    }
  ],
  "expectedOutput": {
    "columns": ["name"],
    "rows": [
      ["Henry"],
      ["Max"]
    ]
  },
  "solutionQuery": "SELECT c.name FROM Customer c LEFT JOIN Orders o ON c.id = o.customer_id WHERE o.id IS NULL;",
  "explanation": "Perform a LEFT JOIN between Customer and Orders on customer_id, and filter for rows where Orders.id IS NULL."
}
