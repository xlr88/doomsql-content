{
  "id": "sql_004",
  "contentVersion": 1,
  "title": "Department Employee Count",
  "difficulty": "EASY",
  "sqlDialect": "SQLITE",
  "tags": ["group by", "count"],
  "description": "Find the total number of employees in each department. Return department_id and employee_count.",
  "orderSensitive": false,
  "tables": [
    {
      "name": "Employee",
      "columns": [
        { "name": "id", "type": "INTEGER", "nullable": false, "primaryKey": true },
        { "name": "name", "type": "TEXT", "nullable": false, "primaryKey": false },
        { "name": "department_id", "type": "INTEGER", "nullable": true, "primaryKey": false }
      ],
      "rows": [
        [1, "John", 10],
        [2, "Alice", 20],
        [3, "Bob", 10],
        [4, "Carol", 30],
        [5, "Dave", 10],
        [6, "Eve", 20]
      ]
    }
  ],
  "expectedOutput": {
    "columns": ["department_id", "employee_count"],
    "rows": [
      [10, 3],
      [20, 2],
      [30, 1]
    ]
  },
  "solutionQuery": "SELECT department_id, COUNT(*) AS employee_count FROM Employee GROUP BY department_id;",
  "explanation": "Group employees by department_id and calculate the count of employees in each department."
}
